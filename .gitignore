node_modules/
dist/
.env
.env.local
# Deploy-time secrets (site password, origin secret). Never committed — a
# password in a committed file is in the repository's history permanently.
.env.deploy
__pycache__/
*.pyc
.venv/
cdk.out/
*.bin
# Must be **/ — a pattern containing a slash is anchored to this file's
# directory, so the old `!tests/fixtures/*.bin` only ever matched a top-level
# tests/fixtures/ that does not exist. Both graph fixtures were therefore
# ignored, and a fresh clone could not run the API suite. Fixed 2026-07-22.
!**/tests/fixtures/*.bin
.checkpoints/
.pytest_cache/
.coverage
# uv.lock is COMMITTED, deliberately: with no CI the Docker image is the
# release artifact, so `uv sync --frozen` must install what the tests ran
# against (DEP-32, TKB decision 2026-07-26). Was ignored until Track B.
cdk.context.json
builder/scratch/
api/.venv/
api/.pytest_cache/
api/dist/

# Regenerable analysis caches, not results. This one is a 7.6 MB dict of every
# artist's degree and popularity percentile from a full build; calibrate.py
# rebuilds it from the archive in ~2 minutes. Left untracked it shows up in
# `git status` for every future session, which is exactly the condition a
# `git add -A` sweeps up by accident.
builder/analysis/*/full-build-degrees.json

# Visual brainstorm companion
.superpowers/
api/eval/baseline-results.txt
api/scratch_server.log
.playwright-results/

# CAU- coherence audit: the served stimulus. TEMPORARY -- it must not reach git
# BEFORE the run, because diffing it against gbl_page_data.json reveals the 12
# inserted red-control artists and destroys CAU-G1. Remove this line and commit
# the file AFTER the judgements are in (spec CAU-AM3/AM4).
builder/analysis/2026-08-04-coherence-audit/cau_page_data.json
