node_modules/
dist/
.env
.env.local
# Deploy-time secrets (site password, origin secret). Never committed — a
# password in a committed file is in the repository's history permanently.
.env.deploy
__pycache__/
*.pyc
.venv/
cdk.out/
*.bin
# Must be **/ — a pattern containing a slash is anchored to this file's
# directory, so the old `!tests/fixtures/*.bin` only ever matched a top-level
# tests/fixtures/ that does not exist. Both graph fixtures were therefore
# ignored, and a fresh clone could not run the API suite. Fixed 2026-07-22.
!**/tests/fixtures/*.bin
.checkpoints/
.pytest_cache/
.coverage
# uv.lock is COMMITTED, deliberately: with no CI the Docker image is the
# release artifact, so `uv sync --frozen` must install what the tests ran
# against (DEP-32, TKB decision 2026-07-26). Was ignored until Track B.
cdk.context.json
builder/scratch/
api/.venv/
api/.pytest_cache/
api/dist/

# Visual brainstorm companion
.superpowers/
api/eval/baseline-results.txt
api/scratch_server.log
.playwright-results/
